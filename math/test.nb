Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Vscreen2", "=", 
  RowBox[{"PotentialSmearing", "[", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["3", "4"]}], "Cij", "*", "b2", "*", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Mu]"}], "*", 
         RowBox[{"r", "^", "2"}]}], "]"}]}], ")"}], "\[Mu]"]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9809704147224503`*^9, 3.9809704150022593`*^9}, {
  3.980970473414525*^9, 3.9809704742210913`*^9}, {3.9809710333667583`*^9, 
  3.9809710357024593`*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"f81cfa81-9ac7-4b92-86ea-48a26b90ee04"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"3", " ", "b2", " ", "Cij", " ", "\[Sigma]", " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", 
       SqrtBox[
        SuperscriptBox["\[Sigma]", "2"]]], "-", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{
            SuperscriptBox["r", "2"], " ", "\[Mu]", " ", 
            SuperscriptBox["\[Sigma]", "2"]}], 
           RowBox[{"\[Mu]", "+", 
            SuperscriptBox["\[Sigma]", "2"]}]]}]], " ", 
        SuperscriptBox["\[Sigma]", "2"]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[Mu]", "+", 
          SuperscriptBox["\[Sigma]", "2"]}], ")"}], 
        RowBox[{"3", "/", "2"}]]]}], ")"}]}], 
   RowBox[{"4", " ", "\[Mu]"}]]}]], "Output",
 CellChangeTimes->{3.980970431759326*^9, 3.980970924386248*^9, 
  3.980971142334733*^9},
 CellLabel->"Out[57]=",ExpressionUUID->"9938d550-8f04-4bb6-9239-d9b30d63c193"]
}, Open  ]],

