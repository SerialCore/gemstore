Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Vstring", "=", 
  RowBox[{"PotentialSmearing", "[", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["3", "4"]}], "Cij", "*", "b", "*", "r"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.977218940889372*^9, 3.9772189470558043`*^9}, {
  3.9772190298713083`*^9, 3.977219029977357*^9}, {3.98097029895098*^9, 
  3.9809703017146597`*^9}, {3.980970453110759*^9, 3.980970456594162*^9}, {
