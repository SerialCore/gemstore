Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Vscreen1", "=", 
  RowBox[{"PotentialSmearing", "[", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["3", "4"]}], "Cij", "*", "b1", "*", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Mu]"}], "*", "r"}], "]"}]}], ")"}], "\[Mu]"]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.980970355826248*^9, 3.980970369230727*^9}, {
   3.980970465506508*^9, 3.9809704699421463`*^9}, 3.980971070806025*^9},
 CellLabel->"In[54]:=",ExpressionUUID->"caf0c57c-b860-4342-9bb9-9fdc3b60bfbd"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"3", " ", "b1", " ", "Cij", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "r"}], " ", "\[Mu]"}]], " ", "\[Sigma]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"4", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"r", " ", "\[Mu]"}]], " ", "r", " ", 
       SuperscriptBox["\[Sigma]", "2"]}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         SuperscriptBox["\[Mu]", "2"], 
         RowBox[{"4", " ", 
          SuperscriptBox["\[Sigma]", "2"]}]]], " ", 
       RowBox[{"(", 
        RowBox[{"\[Mu]", "-", 
         RowBox[{"2", " ", "r", " ", 
          SuperscriptBox["\[Sigma]", "2"]}]}], ")"}], " ", 
       RowBox[{"Erfc", "[", 
        FractionBox[
         RowBox[{"\[Mu]", "-", 
          RowBox[{"2", " ", "r", " ", 
           SuperscriptBox["\[Sigma]", "2"]}]}], 
         RowBox[{"2", " ", 
          SqrtBox[
           SuperscriptBox["\[Sigma]", "2"]]}]], "]"}]}], "-", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         FractionBox["1", "4"], " ", "\[Mu]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"8", " ", "r"}], "+", 
           FractionBox["\[Mu]", 
            SuperscriptBox["\[Sigma]", "2"]]}], ")"}]}]], " ", 
       RowBox[{"(", 
        RowBox[{"\[Mu]", "+", 
         RowBox[{"2", " ", "r", " ", 
          SuperscriptBox["\[Sigma]", "2"]}]}], ")"}], " ", 
       RowBox[{"Erfc", "[", 
        FractionBox[
         RowBox[{"\[Mu]", "+", 
          RowBox[{"2", " ", "r", " ", 
           SuperscriptBox["\[Sigma]", "2"]}]}], 
         RowBox[{"2", " ", 
          SqrtBox[
           SuperscriptBox["\[Sigma]", "2"]]}]], "]"}]}]}], ")"}]}], 
   RowBox[{"16", " ", "r", " ", "\[Mu]", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[Sigma]", "2"], ")"}], 
     RowBox[{"3", "/", "2"}]]}]]}]], "Output",
 CellChangeTimes->{3.980970386846682*^9, 3.980970900700897*^9, 
  3.980971089335964*^9},
 CellLabel->"Out[54]=",ExpressionUUID->"85175a9f-39c9-489e-b2ce-7c6b3462aade"]
}, Open  ]],

