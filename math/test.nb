 CellLabel->"In[48]:=",ExpressionUUID->"0beadc4c-a0a5-4047-a6f3-7292d22049c6"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"3", " ", "b", " ", "Cij", " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["r", "2"]}], " ", 
          SuperscriptBox["\[Sigma]", "2"]}]], " ", "r", " ", "\[Sigma]"}], 
       SqrtBox["\[Pi]"]], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"2", " ", 
          SuperscriptBox["r", "2"], " ", 
          SuperscriptBox["\[Sigma]", "2"]}]}], ")"}], " ", 
       RowBox[{"Erf", "[", 
        RowBox[{"r", " ", "\[Sigma]"}], "]"}]}]}], ")"}]}], 
   RowBox[{"8", " ", "r", " ", 
    SuperscriptBox["\[Sigma]", "2"]}]]}]], "Output",
 CellChangeTimes->{3.977218973359107*^9, 3.9772190422071133`*^9, 
  3.9809703165316277`*^9, 3.980970820232379*^9},
 CellLabel->"Out[48]=",ExpressionUUID->"41cd661a-3080-4965-9015-6ac6491eefb9"]
}, Open  ]],

